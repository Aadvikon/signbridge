# SignBridge Production Environment Configuration
# Copy this file to .env on Railway for production deployment
# Replace all placeholder values with actual production secrets

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=False

# CORS Configuration
# Update with your Vercel frontend URL after deployment
CORS_ORIGINS=https://your-app.vercel.app

# Allowed Hosts (for trusted host middleware)
# Update with your Railway backend domain
ALLOWED_HOSTS=your-railway-backend-url.railway.app

# Database - Supabase (Production)
# Create a new Supabase project for production
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# Auth (Production)
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secure-random-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage - Cloudflare R2 (Production)
# Set up a production bucket in Cloudflare R2
R2_ACCOUNT_ID=your-production-account-id
R2_ACCESS_KEY_ID=your-production-access-key
R2_SECRET_ACCESS_KEY=your-production-secret-key
R2_BUCKET_NAME=signbridge-videos-prod

# Payments - Stripe (Production)
# Use LIVE keys (sk_live_*, pk_live_*) not test keys
STRIPE_SECRET_KEY=sk_live_your_production_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_production_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# AI/ML Configuration
MODEL_PATH=models/trained/sign_language_model.h5
WLASL_DATASET_PATH=data/raw/wlasl_videos
MEDIAPIPE_CONFIDENCE_THRESHOLD=0.5

# OpenAI Whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Environment (Production)
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=WARNING
